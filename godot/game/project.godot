; Seas the Booty, the Steam game (Godot port, started 2026-09-30).
; See README.md here and docs/systems/steam-port.md.

config_version=5

[application]

config/name="Seas the Booty"
config/features=PackedStringArray("4.7")
run/main_scene="res://main.tscn"
; The saves live in %APPDATA%/Seas the Booty (Steam Auto-Cloud syncs its captains/).
config/use_custom_user_dir=true
config/custom_user_dir_name="Seas the Booty"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

rendering_device/vsync/frame_queue_size=1
