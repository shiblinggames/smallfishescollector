    "riddles": {
      "shallows-0": "Black birds hang their wings to dry on me, a short row east of home.",
      "shallows-1": "Diving birds gave me my name. I lie south of home in the shallow water.",
      "shallows-2": "My weed lies low and my name says so. West of home, in the shallows.",
      "open_waters-0": "A salted fist, clenched in the open water, east where the sun comes up.",
      "open_waters-1": "My flag never climbs all the way. Out in the open water, to the south-east.",
      "open_waters-2": "I am the colour of old bone under the open water, south of home.",
      "open_waters-3": "I boil without a fire, out in the open water, south and a little west.",
      "open_waters-4": "A broken spar points out of me, west of home in the open water.",
      "open_waters-5": "Ships once rested here and none do now. Far west, in the open water.",
      "deep-0": "Dark fins circle my shoulder, east in the Deep.",
      "deep-1": "I rock nothing but the swell, south-east in the Deep.",
      "deep-2": "Bones and salt, due south where the Deep begins to bite.",
      "deep-3": "My name is a depth, and I stand south-west in the Deep.",
      "deep-4": "Hush here. A flat ledge, west in the Deep.",
      "deep-5": "Built from what the sea broke, far west in the Deep.",
      "abyss-0": "A dark fang bites at the sky, far east where the Abyss starts.",
      "abyss-1": "Even the fish shiver round me, south-east in the Abyss.",
      "abyss-2": "A stair that only goes down, south in the Abyss.",
      "abyss-3": "I carry a light for nobody, south and a touch west in the Abyss.",
      "abyss-4": "Nothing moves in my water. West, in the Abyss.",
      "abyss-5": "Worth less than a coin and twice as hard to find, far west in the Abyss.",
      "ancient_deep-0": "Before anything, there was me. East, in the Ancient Deep.",
      "ancient_deep-1": "Something grew me and left me, south-east in the Ancient Deep.",
      "ancient_deep-2": "Past me the map gives up. South, in the Ancient Deep.",
      "ancient_deep-3": "The water round me forgot how to move. Deep south, and west of it.",
      "ancient_deep-4": "Nobody claims me, south-west in the Ancient Deep.",
      "ancient_deep-5": "Drop the lead here and it keeps on falling, at the western edge of the Ancient Deep."
    }
