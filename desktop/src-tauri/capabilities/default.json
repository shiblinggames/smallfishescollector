{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window may reach its own data folder (the save) and nothing else on disk.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:scope-appdata-recursive"
  ]
}
