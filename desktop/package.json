{
  "name": "seas-the-booty-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Steam prep: the game, offline, in an Electron shell. The front end is the website's own files.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && node electron/start.mjs",
    "app:dev": "node electron/dev.mjs",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "framer-motion": "^12",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.shiblinggames.seasthebooty",
    "productName": "Seas the Booty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.png",
      "electron/steam.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**"
    ]
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "steamAppId": null
}
