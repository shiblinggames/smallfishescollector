{
  // Type-checks the shell (npm run typecheck). `@` resolves into ../web exactly
  // as vite.config.ts does, with the one swap: the Game API is the local one.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/lib/gameApi": ["./src/localGameApi.ts"],
      // The same stand-ins vite.config.ts swaps in, so the screens are checked
      // against what the shell actually gives them.
      "@/lib/supabase/client": ["./src/shims/supabaseClient.ts"],
      "@/lib/navState": ["./src/shims/navState.ts"],
      "next/navigation": ["./src/shims/navigation.tsx"],
      "next/link": ["./src/shims/link.tsx"],
      "next/dynamic": ["./src/shims/dynamic.tsx"],
      "next/image": ["./src/shims/image.tsx"],
      // One React for both trees, as vite.config.ts dedupes it at runtime.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "framer-motion": ["./node_modules/framer-motion"],
      "@/*": ["../web/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
