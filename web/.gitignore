# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
card-art-uploads/
# Local asset tooling (slicers, uploaders) stays out of the repo, but the
# campaign checker runs in prebuild and MUST ship. Note the glob: `scripts/`
# would ignore the directory itself, and git will not descend into an ignored
# directory, so a `!scripts/...` negation under it does nothing.
scripts/*
!scripts/check-campaign.mts

# Badge slicer source sheets (dev-only input for slice-badges.mjs; sliced output in public/badges/ is committed)
public/badgebatch*.png
.git-commit-msg.tmp
